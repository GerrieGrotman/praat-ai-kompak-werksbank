{
  "manifest_version": 3,
  "name": "Praat.ai kompak werksbank",
  "short_name": "Praat.ai kompak werksbank",
  "version": "1.0.1",
  "description": "Compacts the Praat.ai transcription workbench for a small laptop, with a large text box and no page scrolling.",
  "homepage_url": "https://github.com/GerrieGrotman/praat-ai-kompak-werksbank",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Praat.ai kompak werksbank",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-compact": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Toggle compact transcription layout"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://praat.ai/*", "https://www.praat.ai/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
